<mxfile host="app.diagrams.net" type="device"><diagram id="architecture-context" name="C4 L1 - Context"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="architecture-context-title" value="C4 Level 1 - Context: библиотечная система" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1140" height="36" as="geometry"/></mxCell><mxCell id="architecture-context-reader" value="&lt;b style=&quot;font-size:14px&quot;&gt;Читатель&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Пользователь]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Смотрит каталог, берёт книги и возвращает их&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E5C;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="260" height="120" as="geometry"/></mxCell><mxCell id="architecture-context-librarian" value="&lt;b style=&quot;font-size:14px&quot;&gt;Библиотекарь&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Сотрудник]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Ведёт каталог книг, список читателей и выдачи&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E5C;" vertex="1" parent="1"><mxGeometry x="70" y="380" width="260" height="120" as="geometry"/></mxCell><mxCell id="architecture-context-system" value="&lt;b style=&quot;font-size:14px&quot;&gt;Библиотечная система&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Программная система]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Каталог книг, читатели, выдача и возврат через REST API&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;" vertex="1" parent="1"><mxGeometry x="720" y="250" width="340" height="170" as="geometry"/></mxCell><mxCell id="architecture-context-e0" value="Смотрит каталог,&lt;br&gt;берёт и возвращает книги&lt;br&gt;[HTTP]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-context-reader" target="architecture-context-system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-context-e1" value="Управляет книгами,&lt;br&gt;читателями и выдачами&lt;br&gt;[HTTP, Postman / curl]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-context-librarian" target="architecture-context-system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-context-n0" value="Основной сценарий: библиотекарь добавляет книгу и читателя, выдаёт книгу читателю, затем принимает её обратно. При выдаче число доступных экземпляров уменьшается, при возврате увеличивается.&lt;br&gt;Стрелка показывает направление запроса, в скобках указан протокол." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="1060" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="architecture" name="C4 L2 - Container"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="architecture-title" value="C4 Level 2 - Container: библиотечная система" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1500" height="36" as="geometry"/></mxCell><mxCell id="architecture-b0" value="Библиотечная система [Docker Compose, сеть library-net]" style="rounded=1;arcSize=2;fillColor=none;dashed=1;dashPattern=8 6;strokeColor=#444444;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#222222;html=1;" vertex="1" parent="1"><mxGeometry x="310" y="70" width="1210" height="790" as="geometry"/></mxCell><mxCell id="architecture-reader" value="&lt;b style=&quot;font-size:14px&quot;&gt;Читатель&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Пользователь]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Смотрит каталог, берёт и возвращает книги&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E5C;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="210" height="110" as="geometry"/></mxCell><mxCell id="architecture-librarian" value="&lt;b style=&quot;font-size:14px&quot;&gt;Библиотекарь&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Сотрудник]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Ведёт каталог, читателей и выдачи&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#052E5C;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="210" height="110" as="geometry"/></mxCell><mxCell id="architecture-gw" value="&lt;b style=&quot;font-size:14px&quot;&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Nginx]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Единая точка входа: маршрутизация по пути /books, /readers, /loans&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="370" y="395" width="190" height="120" as="geometry"/></mxCell><mxCell id="architecture-catalog" value="&lt;b style=&quot;font-size:14px&quot;&gt;catalog-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Java, Spring Boot]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Каталог книг, число доступных экземпляров&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="220" height="120" as="geometry"/></mxCell><mxCell id="architecture-loan" value="&lt;b style=&quot;font-size:14px&quot;&gt;loan-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Java, Spring Boot]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Выдача и возврат книг, история выдач&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="700" y="395" width="220" height="120" as="geometry"/></mxCell><mxCell id="architecture-reader_svc" value="&lt;b style=&quot;font-size:14px&quot;&gt;reader-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Java, Spring Boot]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Читатели библиотеки&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="700" y="660" width="220" height="120" as="geometry"/></mxCell><mxCell id="architecture-pg" value="&lt;b style=&quot;font-size:14px&quot;&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: postgres:16]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;База app: таблицы books, readers, loans. Данные в volume db_data&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="1250" y="385" width="230" height="140" as="geometry"/></mxCell><mxCell id="architecture-e0" value="Запросы&lt;br&gt;[HTTP]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-reader" target="architecture-gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-e1" value="Запросы&lt;br&gt;[HTTP]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-librarian" target="architecture-gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-e2" value="/books&lt;br&gt;[HTTP]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-gw" target="architecture-catalog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-e3" value="/loans&lt;br&gt;[HTTP]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-gw" target="architecture-loan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-e4" value="/readers&lt;br&gt;[HTTP]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-gw" target="architecture-reader_svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-e5" value="Взять / вернуть&lt;br&gt;экземпляр [HTTP]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-loan" target="architecture-catalog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-e6" value="Проверить читателя&lt;br&gt;[HTTP]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-loan" target="architecture-reader_svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-e7" value="SQL [JDBC]&lt;br&gt;таблица books" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-catalog" target="architecture-pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-e8" value="SQL [JDBC]&lt;br&gt;таблица loans" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-loan" target="architecture-pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-e9" value="SQL [JDBC]&lt;br&gt;таблица readers" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-reader_svc" target="architecture-pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-n0" value="Стрелка показывает направление запроса, в скобках указан протокол. Читатель и библиотекарь работают через Postman или curl. Все три сервиса используют одну базу app, у каждого сервиса свои таблицы." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="885" width="1450" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="architecture-component" name="C4 L3 - Component"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="architecture-component-title" value="C4 Level 3 - Component: loan-service" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1440" height="36" as="geometry"/></mxCell><mxCell id="architecture-component-b0" value="loan-service [Container: Java, Spring Boot]" style="rounded=1;arcSize=2;fillColor=none;dashed=1;dashPattern=8 6;strokeColor=#444444;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#222222;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="900" height="650" as="geometry"/></mxCell><mxCell id="architecture-component-gw" value="&lt;b style=&quot;font-size:14px&quot;&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Nginx]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Передаёт запросы /loans&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="190" height="100" as="geometry"/></mxCell><mxCell id="architecture-component-ctrl" value="&lt;b style=&quot;font-size:14px&quot;&gt;LoanController&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Controller]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;POST /loans, GET /loans, POST /loans/{id}/return&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2A4A;strokeColor=#5D9DD5;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="200" height="100" as="geometry"/></mxCell><mxCell id="architecture-component-svc" value="&lt;b style=&quot;font-size:14px&quot;&gt;LoanService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Service]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Логика выдачи и возврата&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2A4A;strokeColor=#5D9DD5;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="200" height="100" as="geometry"/></mxCell><mxCell id="architecture-component-repo" value="&lt;b style=&quot;font-size:14px&quot;&gt;LoanRepository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Repository]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;SQL-запросы по таблице loans&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2A4A;strokeColor=#5D9DD5;" vertex="1" parent="1"><mxGeometry x="950" y="110" width="200" height="100" as="geometry"/></mxCell><mxCell id="architecture-component-cclient" value="&lt;b style=&quot;font-size:14px&quot;&gt;CatalogClient&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[HTTP client]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Взять и вернуть экземпляр книги&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2A4A;strokeColor=#5D9DD5;" vertex="1" parent="1"><mxGeometry x="950" y="330" width="200" height="100" as="geometry"/></mxCell><mxCell id="architecture-component-rclient" value="&lt;b style=&quot;font-size:14px&quot;&gt;ReaderClient&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[HTTP client]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Проверить, что читатель существует&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0B2A4A;strokeColor=#5D9DD5;" vertex="1" parent="1"><mxGeometry x="950" y="550" width="200" height="100" as="geometry"/></mxCell><mxCell id="architecture-component-pg" value="&lt;b style=&quot;font-size:14px&quot;&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: postgres:16]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Таблица loans&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="1260" y="100" width="210" height="120" as="geometry"/></mxCell><mxCell id="architecture-component-catalog" value="&lt;b style=&quot;font-size:14px&quot;&gt;catalog-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Java, Spring Boot]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Каталог книг&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="1260" y="330" width="210" height="100" as="geometry"/></mxCell><mxCell id="architecture-component-reader_svc" value="&lt;b style=&quot;font-size:14px&quot;&gt;reader-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Java, Spring Boot]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Читатели&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#2E6295;" vertex="1" parent="1"><mxGeometry x="1260" y="550" width="210" height="100" as="geometry"/></mxCell><mxCell id="architecture-component-e0" value="HTTP" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-component-gw" target="architecture-component-ctrl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-component-e1" value="вызывает" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-component-ctrl" target="architecture-component-svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-component-e2" value="сохраняет" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-component-svc" target="architecture-component-repo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-component-e3" value="вызывает" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-component-svc" target="architecture-component-cclient"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-component-e4" value="вызывает" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-component-svc" target="architecture-component-rclient"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-component-e5" value="SQL" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-component-repo" target="architecture-component-pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-component-e6" value="HTTP" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-component-cclient" target="architecture-component-catalog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-component-e7" value="HTTP" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;strokeColor=#444444;fontSize=11;fontColor=#222222;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="architecture-component-rclient" target="architecture-component-reader_svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="architecture-component-n0" value="Контроллер принимает запрос, сервис содержит логику, репозиторий работает с PostgreSQL, клиенты вызывают соседние сервисы по HTTP. Стрелка показывает направление вызова." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="740" width="1400" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>